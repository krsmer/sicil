{
  "mcpServers": {
    "avalanche-docs": {
      "type": "http",
      "url": "https://build.avax.network/api/mcp"
    },
    "okx-demo": {
      "type": "stdio",
      "command": "okx-trade-mcp",
      "args": [
        "--profile",
        "demo",
        "--read-only",
        "--modules",
        "market,spot,account"
      ]
    },
    "okx-market": {
      "type": "stdio",
      "command": "okx-trade-mcp",
      "args": [
        "--profile",
        "piyasa",
        "--read-only",
        "--modules",
        "market"
      ]
    }
  }
}
